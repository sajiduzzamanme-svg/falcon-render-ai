# Falcon Render AI — copy to .env and fill in. Never commit real values.
# Gemini (Nano Banana family) image API key. Without it, render generation
# returns HTTP 503 RENDER_PROVIDER_NOT_CONFIGURED — never a fake image.
GEMINI_API_KEY=

# Backend
API_HOST=127.0.0.1
API_PORT=8000
STORAGE_DIR=./storage

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
