# Falcon Render AI — copy to .env and fill in. Never commit real values.
# Gemini (Nano Banana family) image API key. Without it, render generation
# returns HTTP 503 RENDER_PROVIDER_NOT_CONFIGURED — never a fake image.
GEMINI_API_KEY=

# OpenRouter key (preferred when set — routes to google/gemini-2.5-flash-image
# via https://openrouter.ai/api/v1). Falls back to GEMINI_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-image

# Fidelity gate: while the edge-recall score is below FIDELITY_MIN_SCORE the
# render is retried (up to FIDELITY_MAX_ATTEMPTS); the best attempt is kept.
# 0.0 disables the gate (score is still recorded on every job).
# Each retry costs one provider call — calibrate from real renders first
# (initial data: faithful ~0.66, visibly drifted ~0.45; start near 0.55).
FIDELITY_MIN_SCORE=0.0
FIDELITY_MAX_ATTEMPTS=3

# Backend
API_HOST=127.0.0.1
API_PORT=8000
STORAGE_DIR=./storage

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
