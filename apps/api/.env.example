# Falcon Render AI backend — copy to .env and fill in.
# Never commit a filled-in .env.

# Render provider (at least one required for generation).
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Supabase (ADR 0002). When SUPABASE_URL and SUPABASE_SERVICE_KEY are both
# set, the Supabase job store + credit ledger are used; otherwise the local
# JSON store (local dev, renders free).
SUPABASE_URL=https://pzdtgkgfsleyafhqvujd.supabase.co
# The sb_secret_... Secret API key (server only). NEVER the publishable key,
# and never put this in frontend code. The legacy service_role JWT does not
# work via the apikey header alone.
SUPABASE_SERVICE_KEY=
# Public JWKS for verifying Supabase-issued user access JWTs (downloads).
SUPABASE_JWKS_URL=https://pzdtgkgfsleyafhqvujd.supabase.co/auth/v1/.well-known/jwks.json

# Fidelity gate (0.0 = disabled; score still recorded).
FIDELITY_MIN_SCORE=0.0
FIDELITY_MAX_ATTEMPTS=3
